#!/bin/sh
# Ocarina of Time: a launcher (Onion Ports) that only hands over to App/OcarinaOfTimePAL/launch.sh, where the game is.
# Generated by miyoo/tools/miyoo_pack.py.
APP=/mnt/SDCARD/App/OcarinaOfTimePAL
mkdir -p "$APP/data"
echo "$(date) Onion Ports: $0 $*" >> "$APP/data/games_launch.log"
# for Onion's ~Import ports (Emu/PORTS/import.sh): the game is at /mnt/SDCARD/App/OcarinaOfTimePAL
GameName="Ocarina of Time PAL"
GameDir="../../../App/OcarinaOfTimePAL"
GameDataFile="launch.sh"
# for Onion on a Mini v4 / Mini Flip: the screen at 752x560 for this game (runtime.sh looks for this line)
FullResolution=1
cd "$APP" || exit 1
exec sh "$APP/launch.sh"
